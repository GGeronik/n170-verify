{
  "name": "n170-verify",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-only portfolio performance calculator with signed, recomputable track records.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "python3 scripts/build-public.py",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test && npm audit signatures && npm audit --audit-level=low",
    "test:browser": "node scripts/browser-ui.mjs",
    "test:storage": "node scripts/browser-storage.mjs",
    "test:lifecycle": "node scripts/browser-lifecycle.mjs",
    "test:accessibility": "node scripts/browser-accessibility.mjs",
    "test:agent-handoff": "node scripts/browser-agent-handoff.mjs",
    "test:security-ease": "node scripts/browser-security-ease.mjs",
    "test:comparison": "node scripts/browser-comparison.mjs",
    "preflight": "python3 scripts/build-public.py --preflight",
    "test:reviewer-journey": "node scripts/browser-reviewer-journey.mjs",
    "test:tool-evidence": "node scripts/browser-tool-evidence.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "vite": "6.4.3"
  }
}

# N170 Verify v3 — Environment Template
# Copy to .env (gitignored) and customize as needed.
# Keep publisher Ed25519 signing seeds strictly OUTSIDE the repository tree.

# Browser-facing and server-facing API base URL for ./web
NEXT_PUBLIC_N170_VERIFY_API_URL=http://127.0.0.1:8080

# Multi-user hosted mode (enforces pending-approval connector policy & zero-retention defaults)
N170_VERIFY_HOSTED_MODE=true

# External host directory (outside the git repository) mounted read-only at /run/n170-verify-keys
# Generate a 32-byte hex seed via: python3 -m n170_verify.cli keygen
N170_VERIFY_HOST_KEY_DIR=/var/tmp/n170-verify-keys
N170_VERIFY_SIGNING_SEED_FILE=/run/n170-verify-keys/publisher_seed.hex
N170_VERIFY_PUBLISHER_KID=

# Zero-retention storage defaults (:memory: keeps published directory & opt-in sync vault ephemeral)
N170_VERIFY_DB_PATH=:memory:
N170_VERIFY_SYNC_DB_PATH=:memory:
N170_VERIFY_SYNC_BACKUP_RETENTION_HOURS=0

# Optional EODHD reference market data token (splits, delisted ISIN lookup, 2-stage fill bounds, rebased benchmark)
# When empty, N170 Verify degrades cleanly to NullReferenceProvider.
EODHD_API_KEY=

# Optional public catalyst enrichment (SEC EDGAR User-Agent & FRED/ALFRED point-in-time macro series)
N170_VERIFY_SEC_USER_AGENT=
FRED_API_KEY=

# Optional local small-LLM coaching narrator (start with: docker compose --profile ollama up -d)
# Supported local models include qwen2.5:7b-instruct and llama3.2:3b; falls back deterministically when offline.
N170_VERIFY_LLM_BASE_URL=http://127.0.0.1:11434/v1
N170_VERIFY_LLM_MODEL=qwen2.5:7b-instruct

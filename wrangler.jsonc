{
  "name": "n170-verify",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-10-07",
  "no_bundle": true,
  "find_additional_modules": false,
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": false
  }
}
